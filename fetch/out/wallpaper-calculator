</div>
</fieldset>
<fieldset><legend>2. Pattern</legend>
<div class="opts" role="group" aria-label="Pattern repeat">
<button type="button" data-p="0" class="on"><b>Plain or no match</b><span>No pattern repeat</span></button>
<button type="button" data-p="27"><b>Small repeat</b><span>up to 27 cm (10.6 in)</span></button>
<button type="button" data-p="64"><b>Large repeat</b><span>up to 64 cm (25 in)</span></button>
</div>
</fieldset>
